# Resend — envio do diagnóstico por e-mail
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM="VOW Diagnóstico <diagnostico@grupovow.com.br>"
MAIL_REPLY_TO=comercial@grupovow.com.br

# URL pública do serviço — usada para montar o QR code do totem
PUBLIC_BASE_URL=https://vow-abras.onrender.com

# Senha da plataforma de leads (Basic Auth). Sem isso, /leads fica aberto.
LEADS_USER=vow
LEADS_PASSWORD=troque-me

# Banco. Em produção vem do Render; local, aponte para um Postgres seu.
# Sem esta variável a aplicação grava em memória e perde tudo ao encerrar.
DATABASE_URL=

# Só para a migração única do disco antigo para o banco.
LEADS_DB=./data/leads.json

PORT=3000

# Admin da plataforma (usado pelo seed)
ADMIN_EMAIL=rodrobau@gmail.com

# Assina o cookie de sessao. Em producao o Render gera pelo blueprint.
SESSION_SECRET=

APP_DB=./data/db.json
